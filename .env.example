# Copia este archivo como .env (ignorado por git) y completa los valores.
# Repositorio público: NUNCA subas el archivo .env.

# --- Servidor ---
NODE_ENV=development
# Puerto de la API en desarrollo (Vite, en 5180, redirige /api aquí).
# En producción Render define PORT y la API usa ese.
API_PORT=3180
# HOST se calcula solo: 127.0.0.1 en desarrollo, 0.0.0.0 en producción.
# URL pública desde la que se abre la app. En desarrollo usa 127.0.0.1, no localhost (Spotify no acepta localhost).
PUBLIC_BASE_URL=http://127.0.0.1:5180
TIMEZONE=America/Bogota

# --- Se usan desde la etapa E1 (Spotify) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5180/api/auth/spotify/callback
# ALLOWED_HOST_SPOTIFY_IDS=
# TOKEN_ENCRYPTION_KEY=   (32 bytes en base64: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
# COOKIE_SECRET=          (igual que la anterior, otro valor)
# DEFAULT_MARKET=CO

# --- Se usan desde las etapas E2 y E5 ---
# SESSION_TTL_HOURS=24
# SYNC_LEAD_MS=20000
# KEEP_AWAKE_INTERVAL_MS=600000
# KEEP_AWAKE_UNTIL=04:00
